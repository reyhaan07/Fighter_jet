{
  "name": "fighter-jet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline 3D fighter-jet combat game (Three.js + Vite)",
  "scripts": {
    "dev": "vite --open",
    "dev:serve": "vite",
    "build": "vite build",
    "play": "vite build && vite preview --open",
    "preview": "vite preview --open",
    "stress": "node scripts/stress.mjs",
    "icons": "node scripts/make-icons.mjs",
    "desktop:tauri": "npx --yes @tauri-apps/cli@2 build",
    "desktop:tauri:dev": "npx --yes @tauri-apps/cli@2 dev",
    "desktop:electron": "npm run build && npx --yes electron@33 .",
    "desktop:electron:package": "npm run build && npx --yes @electron/packager@18 . \"Strike Wing\" --out=release --overwrite --icon=src-tauri/icons/icon --ignore=^/src/ --ignore=^/src-tauri --ignore=^/node_modules --ignore=^/scripts --ignore=^/release --ignore=^/stress-shots"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.2"
  },
  "main": "electron/main.cjs"
}
